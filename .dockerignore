# =============================================================================
# .dockerignore — keeps build contexts small and prevents secrets/artifacts
# from leaking into images. Build context is the monorepo root for the api/web
# images, so these globs apply across every workspace.
# =============================================================================

# ----- Dependencies (reinstalled inside the image) -----
**/node_modules
node_modules
.pnp
.pnp.js
.yarn

# ----- Build / compile output -----
**/dist
**/build
**/.next
**/out
**/.turbo
**/coverage
**/.tsbuildinfo
*.tsbuildinfo

# ----- Python (apps/agents) -----
**/__pycache__
**/*.pyc
**/*.pyo
**/.venv
**/venv
**/.mypy_cache
**/.pytest_cache

# ----- Secrets & local environment (NEVER ship these) -----
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key

# ----- Version control & CI -----
.git
.gitignore
.github
.gitattributes

# ----- Docker / compose (not needed inside the image) -----
Dockerfile
**/Dockerfile
docker-compose.yml
docker-compose.*.yml
.dockerignore

# ----- Editor / OS cruft -----
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# ----- Logs & temp -----
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs
*.tmp

# ----- Docs & meta (not required at runtime) -----
README.md
OPENCLAW_ONBOARDING.md
**/*.md
LICENSE

# ----- Test artifacts -----
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
