# ============================================================
# SSD STUDIO — AUTOMATED CLIENT PIPELINE
# Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================

# --- DATABASE ---
DATABASE_URL="postgresql://ssd_user:ssd_password@localhost:5432/ssd_studio_db"
POSTGRES_USER=ssd_user
POSTGRES_PASSWORD=ssd_password
POSTGRES_DB=ssd_studio_db
POSTGRES_PORT=5432

# --- JWT AUTHENTICATION ---
JWT_SECRET="your-super-secret-jwt-key-minimum-32-chars-long"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-secret-key-minimum-32-chars-long"
JWT_REFRESH_EXPIRES_IN="30d"

# --- API SERVER ---
API_PORT=4000
API_HOST=localhost
NODE_ENV=development
API_BASE_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# --- NEXT.JS FRONTEND ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SSD Studio"

# --- AMAZON S3 / MEDIA DELIVERY ---
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"
S3_BUCKET_RAW="ssd-studio-raw-assets"
S3_BUCKET_FINAL="ssd-studio-final-assets"
S3_PRESIGNED_URL_EXPIRY_SECONDS=86400

# --- RESEND EMAIL API ---
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="SSD Studio <noreply@ssdstudio.com>"
EMAIL_REPLY_TO="hello@ssdstudio.com"

# --- N8N ORCHESTRATION ---
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD="your-n8n-admin-password"
N8N_WEBHOOK_URL="http://localhost:5678/webhook"
N8N_ENCRYPTION_KEY="your-n8n-encryption-key-32-chars"

# --- PAYMENT (STRIPE) ---
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"

# --- LIVEKIT WEBRTC ---
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"
LIVEKIT_URL="wss://your-livekit-server.livekit.cloud"

# --- FASTMCP AGENT SERVER ---
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8080
MCP_SSE_PATH=/sse
MCP_SECRET_KEY="your-mcp-secret-key-for-hitl-validation"

# --- CRYPTOGRAPHIC HITL SAFEGUARDS ---
HITL_HMAC_SECRET="your-hmac-secret-for-human-in-the-loop-validation"
HITL_TOKEN_EXPIRY_SECONDS=300

# --- BOOKING CONFIGURATION ---
BOOKING_SLOT_DURATION_MINUTES=60
BOOKING_LOCK_TTL_SECONDS=300
MAX_CONCURRENT_BOOKINGS=10

# --- REDIS (for distributed locking) ---
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
