{
  "id": "ssdBookingLifecycle01",
  "name": "SSD Studio — Booking Lifecycle",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "booking-created",
        "responseMode": "onReceived",
        "options": {
          "rawBody": true
        },
        "authentication": "headerAuth",
        "headerAuth": {
          "name": "X-Internal-Secret",
          "value": "={{$env[\"N8N_INTERNAL_SECRET\"]}}"
        }
      },
      "id": "webhook-booking-created",
      "name": "Webhook: Booking Created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "a1b2c3d4-e5f6-4789-8abc-bookingcreate"
    },
    {
      "parameters": {
        "emailFormat": "html",
        "fromEmail": "={{$env[\"EMAIL_FROM\"] || \"SSD Studio <noreply@ssdstudio.com>\"}}",
        "toEmail": "={{$json.body.clientEmail}}",
        "subject": "Booking Received — SSD Studio",
        "html": "<h1>Your booking request is received!</h1><p>Hi {{$json.body.clientName}},</p><p>Thank you for choosing SSD Studio. Your session is scheduled for <strong>{{$json.body.startTime}}</strong>.</p><p>We'll send you a preparation guide 48 hours before your session.</p><p>Reference: {{$json.body.bookingId}}</p>"
      },
      "id": "email-confirmation",
      "name": "Send Confirmation Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "credentials": { "smtp": { "id": "resendSmtpCred0001", "name": "Resend SMTP" } },
      "position": [500, 300]
    },
    {
      "parameters": {
        "resume": "specificTime",
        "dateTime": "={{new Date(new Date($json.body.startTime).getTime() - 48 * 60 * 60 * 1000).toISOString()}}"
      },
      "id": "wait-until-48h-before",
      "name": "Wait Until 48h Before Session",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [750, 300],
      "webhookId": "wait-48h-before"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env[\"API_BASE_URL\"]}}/api/bookings/{{$node[\"Webhook: Booking Created\"].json.body.bookingId}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Secret", "value": "={{$env[\"N8N_INTERNAL_SECRET\"]}}" }
          ]
        }
      },
      "id": "check-status-48h",
      "name": "Check Booking Status (48h)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [950, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.data.status}}",
              "operation": "notEqual",
              "value2": "CANCELLED"
            }
          ]
        }
      },
      "id": "if-not-cancelled-48h",
      "name": "If Not Cancelled (48h)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1150, 300]
    },
    {
      "parameters": {
