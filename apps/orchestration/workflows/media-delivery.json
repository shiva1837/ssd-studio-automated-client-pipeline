{
  "id": "ssdMediaDelivery01",
  "name": "SSD Studio — Media Delivery",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "s3-upload",
        "responseMode": "onReceived",
        "options": {
          "rawBody": true
        },
        "authentication": "headerAuth",
        "headerAuth": {
          "name": "X-Internal-Secret",
          "value": "={{$env[\"N8N_INTERNAL_SECRET\"]}}"
        }
      },
      "id": "webhook-s3-upload",
      "name": "Webhook: S3 Upload",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "f1e2d3c4-b5a6-4987-8def-s3uploadhook1"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"API_BASE_URL\"]}}/api/media/upload-url",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{$env[\"INTERNAL_API_TOKEN\"]}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "bookingId", "value": "={{$json.body.bookingId}}" },
            { "name": "fileName", "value": "={{$json.body.fileName}}" },
            { "name": "fileType", "value": "={{$json.body.fileType}}" }
          ]
        }
      },
      "id": "http-presigned-url",
      "name": "Generate Presigned URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 300]
    },
    {
      "parameters": {
        "emailFormat": "html",
        "fromEmail": "={{$env[\"EMAIL_FROM\"] || \"SSD Studio <noreply@ssdstudio.com>\"}}",
        "toEmail": "={{$node[\"Webhook: S3 Upload\"].json.body.clientEmail}}",
        "subject": "Your Media is Ready — SSD Studio",
        "html": "<h1>Your media is ready for download!</h1><p>Hi {{$node[\"Webhook: S3 Upload\"].json.body.clientName}},</p><p>Your edited files are ready! Click the link below to access your files. The link expires in 24 hours.</p><p><a href='{{$node[\"Generate Presigned URL\"].json.data.downloadUrl}}'>Download Now</a></p><p>Reference: {{$node[\"Webhook: S3 Upload\"].json.body.bookingId}}</p>"
      },
      "id": "email-delivery",
      "name": "Send Delivery Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "credentials": { "smtp": { "id": "resendSmtpCred0001", "name": "Resend SMTP" } },
      "position": [750, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"API_BASE_URL\"]}}/api/media/notify-delivery",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{$env[\"INTERNAL_API_TOKEN\"]}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "assetId", "value": "={{$node[\"Generate Presigned URL\"].json.data.assetId}}" }
          ]
        }
      },
      "id": "http-notify-delivery",
      "name": "Notify Delivery Complete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "amount": 24,
        "unit": "hours"
      },
      "id": "wait-24h-followup",
      "name": "Wait 24h (Follow-up)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1250, 300],
      "webhookId": "wait-24h-followup"
    },
    {
      "parameters": {
        "emailFormat": "html",
        "fromEmail": "={{$env[\"EMAIL_FROM\"] || \"SSD Studio <noreply@ssdstudio.com>\"}}",
        "toEmail": "={{$node[\"Webhook: S3 Upload\"].json.body.clientEmail}}",
        "subject": "How Was Your Experience? — SSD Studio",
        "html": "<h1>We'd Love Your Feedback</h1><p>Hi {{$node[\"Webhook: S3 Upload\"].json.body.clientName}},</p><p>Your session is complete! We hope you love the results. Please take a moment to leave us a review — it helps us continue creating amazing work.</p><p><a href='{{$env[\"FRONTEND_URL\"]}}/review'>Leave a Review</a></p>"
      },
      "id": "email-followup",
      "name": "Send Follow-up + Review Request",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "credentials": { "smtp": { "id": "resendSmtpCred0001", "name": "Resend SMTP" } },
      "position": [1500, 300]
    }
  ],
  "connections": {
    "Webhook: S3 Upload": {
      "main": [[{ "node": "Generate Presigned URL", "type": "main", "index": 0 }]]
    },
    "Generate Presigned URL": {
      "main": [[{ "node": "Send Delivery Email", "type": "main", "index": 0 }]]
    },
    "Send Delivery Email": {
      "main": [[{ "node": "Notify Delivery Complete", "type": "main", "index": 0 }]]
    },
    "Notify Delivery Complete": {
      "main": [[{ "node": "Wait 24h (Follow-up)", "type": "main", "index": 0 }]]
    },
    "Wait 24h (Follow-up)": {
      "main": [[{ "node": "Send Follow-up + Review Request", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [{ "name": "ssd-studio" }, { "name": "media-delivery" }]
}
