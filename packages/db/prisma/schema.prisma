// ============================================================
// SSD STUDIO — PRISMA DATABASE SCHEMA
// PostgreSQL Relational Model for Booking Lifecycle
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum AssetType {
  UNEDITED
  FINAL
}

enum DeliveryStatus {
  PENDING
  URL_GENERATED
  DELIVERED
}

enum ServiceType {
  PORTRAIT_SESSION
  COMMERCIAL_SHOOT
  EVENT_COVERAGE
  BRAND_CAMPAIGN
  PRODUCT_PHOTOGRAPHY
  VIDEO_PRODUCTION
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// ============================================================
// USER MODEL
// ============================================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  phone        String
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  bookings Booking[]

  @@index([email])
  @@map("users")
}

// ============================================================
// BOOKING MODEL
// ============================================================

model Booking {
  id          String        @id @default(uuid()) @db.Uuid
  clientId    String        @db.Uuid
  serviceType String
  startTime   DateTime
  endTime     DateTime
  status      BookingStatus @default(PENDING)
  amountPaid  Float         @default(0)

  // Confirmation & Communication lifecycle timestamps
  confirmationSentAt  DateTime?
  reminderSent48hAt   DateTime?
  reminderSent24hAt   DateTime?
  reminderSentDayOfAt DateTime?
  reminderSent1hAt    DateTime?
  followUpSentAt      DateTime?

  // Calendar integration
  calendarEventId String?
  icsUrl          String?

  // Metadata
  notes           String?
  internalNotes   String?
  stripePaymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  client      User         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  mediaAssets MediaAsset[]

  // NOTE on double-booking prevention:
  // The application enforces no overlapping ACTIVE bookings via a
  // SERIALIZABLE transaction (see apps/api/src/routes/bookings.ts).
  // A partial unique index limited to PENDING/CONFIRMED rows is the
  // recommended DB backstop and can be added via a raw SQL migration
  // (Prisma cannot yet express partial unique indexes declaratively).
  @@index([clientId])
  @@index([startTime])
  @@index([status])
  @@index([startTime, endTime])
  @@map("bookings")
}

// ============================================================
// MEDIA ASSET MODEL
// ============================================================

model MediaAsset {
  id             String         @id @default(uuid()) @db.Uuid
  bookingId      String         @db.Uuid
  s3ObjectKey    String
  assetType      AssetType
  deliveryStatus DeliveryStatus @default(PENDING)
  expiresAt      DateTime?

  // S3 Presigned URL cache
  presignedUrl       String?
  presignedUrlExpiry DateTime?

  // Delivery tracking
  deliveredAt       DateTime?
  deliveryEmailSent Boolean   @default(false)

  // File metadata
  fileName      String?
  fileSizeBytes BigInt?
  mimeType      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([assetType])
  @@index([deliveryStatus])
  @@map("media_assets")
}

// ============================================================
// AUDIT LOG MODEL — Tracks all lifecycle events
// ============================================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String
  action     String
  actorId    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// SYSTEM LOG MODEL — Resilience & error tracking
// Written by the API error handler, the n8n dispatcher, and the
// Python self-healing monitor for centralized observability.
// ============================================================

model SystemLog {
  id         String   @id @default(uuid()) @db.Uuid
  level      LogLevel @default(INFO)
  source     String   // e.g. 'api', 'n8n-dispatch', 'auto-heal-monitor'
  message    String
  context    Json?
  resolved   Boolean  @default(false)
  resolvedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([level])
  @@index([source])
  @@index([resolved])
  @@index([createdAt])
  @@map("system_logs")
}
